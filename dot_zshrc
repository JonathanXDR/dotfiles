source "${HOME}/.exports"
source "${HOME}/.functions"

# Homebrew goes first, because `brew shellenv` prepends its own bin and sbin.
# Naming the shell avoids forking `ps` to guess it, and only the zsh reply puts
# Homebrew's completions on fpath.
if [[ -x "/opt/homebrew/bin/brew" ]]; then
  eval "$(/opt/homebrew/bin/brew shellenv zsh)"
elif [[ -x "/usr/local/bin/brew" ]]; then
  eval "$(/usr/local/bin/brew shellenv zsh)"
fi

# Each is prepended, so the last one wins. Coursier is appended so its launchers
# never shadow a binary from Homebrew or mise.
path:add "$HOME/.local/bin"
path:add "$HOME/.cargo/bin"
path:add "$HOME/.console-ninja/.bin"
path:add "/Library/Frameworks/Python.framework/Versions/Current/bin"
path:add "$HOME/Library/Application Support/JetBrains/Toolbox/scripts"
path:append "$HOME/Library/Application Support/Coursier/bin"

path:append ${(s.:.)PATH_ADD}

# This runs after every other PATH writer, because activation re-derives PATH
# from a snapshot on each prompt, so anything prepended later outranks the
# managed toolchain
cmd:exists mise && eval "$(mise activate zsh)"

# The aws plugin's RPROMPT segment prints literally, because antidote skips the
# oh-my-zsh.sh that sets prompt_subst
SHOW_AWS_PROMPT=false

# This runs before .aliases, which is the authority on any name both define
plugins:load

source "${HOME}/.aliases"
source "${HOME}/.completions"

[[ "${AUTOSTART_SSH_AGENT}" == "true" ]] && ssh:agent

runaway:alerts

cmd:exists mise && run:daily mise mise:update
cmd:exists brew && run:daily brew brew:check
[[ -f "${HOME}/.plugins" ]] && run:daily plugins plugins:update
