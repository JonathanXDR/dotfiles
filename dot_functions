# ---------------------------- Shell & PATH Utils ---------------------------- #

# Logger with a colored "<Level>:" prefix followed by an action-first message.
# Convention:
#   1. Every message starts with a verb, in one of four forms.
#      a. Past tense for completed work (Imported / Skipped / Verified /
#         Detected / Removed).
#      b. "Failed to <verb>" for failures.
#      c. Present participle plus a single … for work in progress
#         (Installing… / Reading…).
#      d. An imperative hint telling the user what to do next
#         (Add tokens manually via 'secret:set' / Run 'brew bundle cleanup'
#         to remove them).
#      The … belongs to form (c) alone, so a past-tense message never
#      carries one.
#   2. The message body MUST NOT contain a formatting colon, since the only
#      colon in the rendered line is the one in the "<Level>:" prefix. Put
#      the detail in parentheses instead.
#      ✓ "Success: Imported 12 secrets"
#      ✗ "Success: Imported: 12 secrets"      (two colons)
#      ✗ "Warning: Detected packages:"        (trailing list-colon)
#   Colons inside data values (URLs, function names like `secret:rename`,
#   port numbers like `:8080`) are fine, since those aren't formatting.
log() {
  local level="$1"; shift
  local red green yellow blue gray reset

  if [[ -t 2 ]]; then
    red='\033[0;31m' green='\033[0;32m' yellow='\033[0;33m'
    blue='\033[0;34m' gray='\033[0;90m' reset='\033[0m'
  fi

  case "$level" in
    error|red)      printf "${red}Error:${reset}   %s\n" "$*" >&2 ;;
    success|green)  printf "${green}Success:${reset} %s\n" "$*" ;;
    warning|yellow) printf "${yellow}Warning:${reset} %s\n" "$*" >&2 ;;
    info|blue)      printf "${blue}Info:${reset}    %s\n" "$*" ;;
    debug)          [[ -n "${DEBUG:-}" ]] && printf "${gray}Debug:${reset}   %s\n" "$*" >&2 ;;
    *)              echo "$level" "$@" ;;
  esac
}

# Redraw a single progress line on stderr, styled as an in-progress log message,
# for work slow enough to look hung. It draws only on a terminal: run:daily
# points stderr at a report file, where the carriage returns and erase codes
# would land as garbage. The line is cut to the terminal width, because a
# wrapped line breaks the carriage-return redraw. Call progress:clear before any
# other output, or that output prints over the bar.
# Usage: progress:bar <done> <total> <message> [detail]
progress:bar() {
  [[ -t 2 ]] || return 0
  local done="$1" total="$2" message="$3" detail="${4:-}"
  local width=24 filled body cols="${COLUMNS:-0}"
  (( total > 0 )) || return 0
  (( cols > 0 )) || cols=80

  filled=$(( done * width / total ))
  body="${message} ${(l:filled::█:)}${(l:width-filled::░:)} ${done}/${total}${detail:+ (${detail})}"
  (( ${#body} > cols - 10 )) && body="${body[1,cols-11]}…"
  printf '\r\033[K\033[0;34mInfo:\033[0m    %s' "$body" >&2
}

# Erase the line progress:bar drew, so the next output starts on a clean line.
progress:clear() {
  [[ -t 2 ]] && printf '\r\033[K' >&2
  return 0
}

# Retry a command up to N times with a delay between attempts (from bash-it)
# Usage: retry <attempts> <delay_seconds> <command...>
retry() {
  local attempts="$1" delay="$2"; shift 2
  local i
  for (( i = 1; i <= attempts; i++ )); do
    if "$@"; then
      return 0
    fi
    (( i < attempts )) && sleep "$delay"
  done
  return 1
}

cmd:exists() {
  [[ $# -eq 1 ]] || {
    echo "Usage: cmd:exists <command>" >&2
    return 1
  }
  command -v "$1" &>/dev/null
}

# Internal: true when a binary, function, or builtin already owns this name.
#
# Deliberately narrower than cmd:exists, which also resolves aliases. The Oh My
# Zsh bundle loads before .aliases, so `command -v` would report every plugin
# alias as an existing command and .aliases would step aside for all of them.
# The guards exist to stop a real command from being shadowed. Sitting on top
# of a plugin alias is intended, because .aliases owns the names it sets.
# Usage: alias:_taken <name>
alias:_taken() {
  (( ${+commands[$1]} + ${+functions[$1]} + ${+builtins[$1]} ))
}

# Define an alias only if no command with that name already exists.
# Warns when skipped, so shadowed commands stay visible.
# Usage: alias:safe <name>='<value>'
alias:safe() {
  local name="${1%%=*}"
  if alias:_taken "$name"; then
    log warning "Skipped alias '${name}' (would shadow existing command)"
  else
    alias:_set "$1"
  fi
}

# Silent counterpart to alias:safe, for polyfills where the absence
# of the real command is what triggers the alias.
# Usage: alias:fallback <name>='<value>'
alias:fallback() {
  alias:_taken "${1%%=*}" || alias:_set "$1"
}

# Internal: set an alias and warn if its target is unavailable.
# Resolves the target the way zsh would at expansion time:
#   (z) tokenize, (Q) dequote escapes, (e) expand parameters.
# Usage: alias:_set <name>='<value>'
alias:_set() {
  local -a parts=( ${(z)${1#*=}} )
  local target="${(eQ)parts[1]}"
  [[ -n "$target" ]] && ! cmd:exists "$target" \
    && log warning "Defined alias '${1%%=*}' (target '${target}' is not available)"
  alias "$1"
}

# Drop suffix aliases whose target command is not installed. The common-aliases
# plugin ships 35 of them for a Linux desktop (mplayer, acroread, xchm, djview,
# xdvi, gv, unace, unrar), and the ones whose tool is missing here would fail on
# first use. Resolves the target the same way alias:_set does.
# Usage: alias:prune-suffix
alias:prune-suffix() {
  local suffix target
  local -a parts
  for suffix in ${(k)saliases}; do
    parts=( ${(z)saliases[$suffix]} )
    target="${(eQ)parts[1]}"
    if [[ -n "$target" ]] && ! cmd:exists "$target"; then
      unalias -s -- "$suffix"
    fi
  done
}

# List every alias and function currently sitting on top of a real binary. The
# plugin bundle has no equivalent of alias:safe, so this is how a plugin update
# that claims a command name stays visible. Functions have to be covered too:
# the aws plugin ships asr as a function rather than an alias, so it lands on
# Apple Software Restore, and log() above sits on /usr/bin/log. Deliberate
# shadows appear here as well, so read the output rather than acting on it.
#
# $commands reads the command hash table, which rehash refreshes so a package
# installed earlier in this session still shows up. whence -p forks a subshell
# per name instead, which across the 872 aliases loaded here costs four seconds
# a call, and it answers from the filesystem, so on the case-insensitive boot
# volume it reports /bin/lS for the lS alias, which is only ls under another
# spelling.
# Usage: alias:shadows
alias:shadows() {
  local name
  rehash
  for name in ${(ko)aliases}; do
    [[ -n "${commands[$name]}" ]] \
      && printf '%-14s %-44s %s\n' "$name" "${aliases[$name]}" "${commands[$name]}"
  done
  # Names starting with _ are completion functions and plugin internals. Nobody
  # types them, so a binary behind one of them is not a shadow.
  for name in ${(ko)functions}; do
    [[ "$name" == _* || -z "${commands[$name]}" ]] && continue
    printf '%-14s %-44s %s\n' "$name" '(function)' "${commands[$name]}"
  done
}

# Run a command at most once every 24 hours, detached, and show what the last
# run had to say. Usage: run:daily <name> <command...>
#
# The three callers in .zshrc (mise:update, brew:check, plugins:update) all
# reach the network, and brew:check alone measured about 4.7 s. Running them in
# front of the prompt made the first shell of each day an order of magnitude
# slower than every other one, and slower still offline, where each command
# sits in its own timeout first.
#
# So the work is detached and its output is kept for the next shell to print.
# One shell late is fine for a daily "3 packages are outdated" notice, and it
# beats both blocking the prompt and writing into a prompt already on screen.
run:daily() {
  local name="$1"; shift
  local stamp="${HOME}/.cache/daily/${name}"
  local report="${stamp}.report"

  # Whatever the last detached run printed, shown once. The run writes this
  # file only when it finishes, so there is no half-written report to catch.
  # Only a terminal gets it. Shells without one (an editor capturing the login
  # environment, Claude Code's shell snapshot) would swallow it, and the report
  # is the only place a timeout or a failed update ever shows up.
  [[ -t 1 && -s "$report" ]] && { cat "$report"; command rm -f "$report" }

  # A run still alive well past its timeout means the watchdog failed as well,
  # the way the old background job stopped together with its watchdog. Say so
  # in every terminal shell until it is gone, rather than letting it spin
  # unnoticed for days. A pid file left by a run that died without cleaning up
  # (reboot, SIGKILL) is removed, and so is one whose pid now belongs to some
  # other process. The age test is a glob qualifier, so this costs no fork
  # unless a pid file is overdue.
  local pidfile="${stamp}.pid"
  local -i limit=$(( ${RUN_DAILY_TIMEOUT:-300} / 60 + 2 ))
  local -a overdue=( ${pidfile}(N.mm+${limit}) )
  if (( ${#overdue} )); then
    local pid=$(<"$pidfile")
    if [[ "$pid" == <-> ]] && kill -0 "$pid" 2>/dev/null \
        && [[ "$(ps -o command= -p "$pid" 2>/dev/null)" == *_run:daily* ]]; then
      [[ -t 1 ]] && log warning "Detected ${name} still running after ${limit} minutes (stop it with 'kill -- -${pid}')" 2>&1
    else
      command rm -f "$pidfile"
    fi
  fi

  # `mh-24` also matches a stamp dated in the future (clock skew, restored
  # backup), which would gate the command off forever, so exclude that case
  # with `^ms-0`. Not `ms+0`, which demands an age of at least a second and so
  # rejects a stamp written in this very second, reopening the burst that the
  # stamp-before-launch rule below exists to close.
  local -a fresh=( ${stamp}(N.mh-24^ms-0) )
  (( ${#fresh} )) && return 0

  mkdir -p "${stamp:h}"
  # Stamp before launching rather than on success. Every caller already returns
  # 0 unconditionally so the day gets stamped either way, and stamping first
  # keeps most of a burst of new tabs from each starting its own copy of the
  # same update against the same clones. Tabs that start within a few
  # milliseconds of each other still pass the check together, and the lock in
  # _run:daily turns all but one of those copies away.
  touch "$stamp"

  # Detach into a new session, not just into the background. A job forked with
  # `&!` from an interactive shell stays a process group on this terminal, and
  # the terminal stops that whole group (SIGTTOU, SIGTTIN) as soon as anything
  # in it changes the tty settings or reads from the tty. antidote 2.3.0 does
  # the first on every run: its `read -rd ''` from a heredoc makes zsh switch
  # the terminal out of canonical mode. The group stops, the watchdog's sleep
  # with it, and the `$(...)` subshell, which zsh exempts from those signals,
  # busy-loops on its stopped child at 100% CPU until killed (a macOS /bin/zsh
  # 5.9 bug, fixed in 5.9.2), even after the tab closes. Seen for 18 h in
  # September, 6 days from October 28 and 41 h from November 1.
  #
  # A new session has no controlling terminal, so nothing in the job can reach
  # this one: /dev/tty fails with ENXIO, a prompt fails instead of waiting, and
  # closing the tab no longer hangs up a half-done update. macOS has no
  # setsid(1), so perl forks and calls setsid(2), and a fresh zsh reloads these
  # functions. `-f` keeps every other startup file out (the environment is
  # inherited), and nice keeps the priority that BG_NICE used to give the job.
  # The warning goes into the report, because startup stderr is not always on
  # screen (the GitKraken ZDOTDIR shim in Zed terminals discards it).
  [[ -x /usr/bin/perl ]] || {
    log warning "Skipped ${name} (/usr/bin/perl is missing, so it cannot run detached)" 2>>"$report"
    return 0
  }
  /usr/bin/perl -MPOSIX -e 'defined(my $pid = fork) or exit 1; exit 0 if $pid;
      POSIX::setsid() > 0 or exit 1; exec @ARGV or exit 1' \
    /usr/bin/nice -n 5 /bin/zsh -fc 'source "${HOME}/.functions" && _run:daily "$@"' \
    run:daily "$name" "$report" "${RUN_DAILY_TIMEOUT:-300}" "$@" </dev/null >/dev/null 2>&1
}

# The detached half of run:daily. Runs the job under a watchdog and publishes
# its report. Usage: _run:daily <name> <report> <timeout> <command...>
#
# Bound the run. Every caller reaches the network and two drive a third-party
# tool, so a wedged update is a question of when, not if, and nothing in front
# of the prompt reveals it. timeout(1) is no use here because the callers are
# functions, not binaries, so watchdog the forked job. TERM first, since
# antidote traps it to remove its tmpdir.
#
# The job is only a wrapper. Every caller runs its slow command inside $(...),
# and antidote forks a git worker per bundle below that, so the process that
# actually wedges sits one to three levels down. Signalling the job alone
# orphans it to keep spinning under launchd. Collect the tree before
# signalling, because killing a parent reparents its children beyond the reach
# of pgrep, and signal the job last, because the waiting parent kills this
# watchdog as soon as the job dies.
_run:daily() {
  local name="$1" report="$2" timeout="$3"; shift 3
  local job watchdog lockfd

  # One run of each job at a time. A second copy would race the first on the
  # same clones (git index.lock errors) and both would write into the same
  # report.new, so whichever copy loses the lock leaves. The lock is released
  # when this shell exits, even on SIGKILL, so it can never go stale. Without
  # zsh/system the job runs unlocked rather than not at all.
  if zmodload -F zsh/system b:zsystem 2>/dev/null; then
    : >>"${report}.lock"
    zsystem flock -t 0 -f lockfd "${report}.lock" 2>/dev/null || return 0
  fi

  # For the overdue check in run:daily. $$ leads this session's process group,
  # so `kill -- -$$` stops everything the run started.
  local pidfile="${report%.report}.pid"
  print -r -- $$ >| "$pidfile"

  "$@" >| "${report}.new" 2>&1 </dev/null &
  job=$!
  ( sleep "$timeout"
    local -a tree=( $job ) level=( $job )
    while level=( ${(f)"$(pgrep -P ${(j:,:)level} 2>/dev/null)"} ); do tree=( $level $tree ); done
    # Into the report, because nothing else sees this detached run. With
    # nothing recorded, a command that times out every day looks exactly like
    # one that had nothing to say, which is the invisibility this watchdog
    # exists to end.
    log warning "Timed out ${name} after ${timeout}s (killed it, run it by hand to see why)" 2>>"${report}.new"
    # Detached, because the parent kills this watchdog the moment the job dies,
    # which is the same instant the TERM below lands. Left inline, the
    # escalation never runs and a descendant that ignores TERM keeps spinning,
    # which is the hang this watchdog exists to end.
    ( sleep 5; kill -KILL $tree 2>/dev/null ) &!
    kill -TERM $tree 2>/dev/null ) & watchdog=$!
  wait $job
  kill $watchdog 2>/dev/null
  command mv -f "${report}.new" "$report"
  command rm -f "$pidfile"
}

# Prepend directories to PATH, skipping the ones that do not exist.
#
# A directory already on PATH is prepended again rather than left alone.
# Something earlier in startup may have appended it (the Kiro CLI pre block
# does exactly that with ~/.local/bin), and skipping would leave the entry
# behind /usr/bin instead of in front of it. `typeset -gU PATH path` in .zshenv
# drops the older copy, so the entry moves rather than repeating.
path:add() {
  local dir
  for dir in "$@"; do
    [[ -d "$dir" ]] && export PATH="$dir:$PATH"
  done
}

# Append directories to PATH (skips missing or duplicate entries)
path:append() {
  local dir
  for dir in "$@"; do
    [[ -d "$dir" ]] && case ":$PATH:" in
      *":$dir:"*) ;;
      *) export PATH="$PATH:$dir" ;;
    esac
  done
}

# Create a new directory and enter it
mkd() {
  mkdir -p "$@" && cd "${@[-1]}" || return
}

# Change to the directory of the frontmost Finder window
cdf() {
  local dir
  # osascript reports its failure on stderr and prints nothing on stdout, and
  # `cd ""` is a no-op that still returns 0, so the guard has to sit on the
  # command substitution instead of on cd.
  dir="$(osascript -e 'tell app "Finder" to POSIX path of (insertion location as alias)')" || return
  cd "$dir"
}

# -------------------------------- Zsh Plugins ------------------------------- #

# Conditional guards for the Oh My Zsh bundle. antidote calls the function named
# in a `conditional:` annotation with no arguments and wraps that entry in a
# plain `if <name>; then ... fi`, so the tool a plugin needs has to be encoded
# in the guard's own name. Each plugin listed here targets a tool that is not
# installed yet, so its entry costs one test per shell until the tool arrives.
local _tool
for _tool in mongocli multipass pre-commit sbt terraform; do
  functions[have:${_tool}]="cmd:exists ${_tool}"
done
unset _tool

# Rails needs its own guard rather than a bare cmd:exists. macOS ships
# /usr/bin/rails, a stub whose only job is to print "Rails is not currently
# installed", so the plain test always succeeds and the plugin would load its 73
# aliases on a machine with no Rails.
have:rails() {
  local bin
  bin="$(whence -p rails)" || return 1
  [[ "$bin" != "/usr/bin/rails" ]]
}

# fzf's setup is pure ZLE. It evaluates `fzf --zsh`, which saves the shell
# options and restores them afterwards. A shell with no terminal has no ZLE to
# restore, so `zsh -ic` prints "can't change option: zle" twice. Such a shell
# has no use for key bindings anyway. The tool test is the second half: the
# plugin probes eight fixed directories and then prints a setup error telling
# the reader to set FZF_BASE, which is what a machine whose Brewfile omits fzf
# sees on every prompt. Both tests have to pass.
have:fzf() {
  [[ -t 0 ]] || return 1
  cmd:exists fzf
}

# Update the cloned plugin repositories, then rebuild the bundle from them.
#
# Nothing else does this. antidote clones a plugin once and never revisits it,
# so the Oh My Zsh checkout would otherwise stay at whatever commit it had on
# the day it was cloned. Runs from run:daily in .zshrc, on the same 24-hour
# stamp as mise:update and brew:check. The four Homebrew plugins in .completions
# are unaffected, because `brew upgrade` already covers those.
# Usage: plugins:update
plugins:update() {
  local antidote="${HOMEBREW_PREFIX}/opt/antidote/share/antidote/antidote.zsh"
  local bundle="${HOME}/.cache/zsh/plugins.zsh"
  local output

  [[ -f "$antidote" && -f "${HOME}/.plugins" ]] || return 0
  source "$antidote"

  if ! output=$(antidote update 2>&1 </dev/null); then
    log warning "Failed to update zsh plugins"
    print -r -- "$output" >&2
    # Return 0 so run:daily still stamps the day, matching mise:update. An
    # offline laptop retries tomorrow rather than on every new shell.
    return 0
  fi

  # Recompile against the updated clones. Rebuilt in place rather than deleted,
  # because if antidote could not regenerate it, deleting would leave the next
  # shell with no plugins, while an older bundle still works. This shell has
  # already sourced the old file, so the new one takes effect next time.
  if ! output=$(antidote bundle < "${HOME}/.plugins" 2>&1 >| "${bundle}.new"); then
    log warning "Failed to rebuild the plugin bundle (keeping the current one)"
    print -r -- "$output" >&2
    command rm -f "${bundle}.new"
    return 0
  fi
  command mv -f "${bundle}.new" "$bundle"

  log success "Updated zsh plugins"
  return 0
}

# Load the Oh My Zsh bundle listed in ~/.plugins.
#
# antidote compiles that list into one flat file under ~/.cache/zsh. antidote
# itself is sourced only when the list is newer than the compiled file, so a
# normal startup reads a single script and does no plugin resolution. Deleting
# the compiled file forces a rebuild.
#
# Called from .zshrc before .aliases, which is the authority on every name it
# also defines. Sourcing the bundle inside a function is deliberate and safe:
# aliases, functions and `typeset -g` values all survive it, and the only value
# that stops reaching the shell is the git plugin's `git_version` scratch
# variable.
# Usage: plugins:load
plugins:load() {
  local list="${HOME}/.plugins"
  local bundle="${HOME}/.cache/zsh/plugins.zsh"
  local antidote="${HOMEBREW_PREFIX}/opt/antidote/share/antidote/antidote.zsh"

  [[ -f "$list" ]] || return 0

  # The docker, kubectl, helm, uv and gh plugins write generated completions
  # here on first use, so it has to exist and sit on fpath before they load.
  # .completions rebuilds fpath afterwards but keeps this entry.
  export ZSH_CACHE_DIR="${HOME}/.cache/oh-my-zsh"
  [[ -d "${ZSH_CACHE_DIR}/completions" ]] || mkdir -p "${ZSH_CACHE_DIR}/completions"
  fpath=("${ZSH_CACHE_DIR}/completions" $fpath)

  # zsh's completion cache, which several plugins reach for at load time via
  # _retrieve_cache/_store_cache. It is off by default, and without it the
  # composer plugin re-runs `composer global config bin-dir` on every shell to
  # find its vendor path, measured at 236 ms against 6 ms once the cache
  # answers. It has to be set here rather than in .completions, because the
  # plugins ask for it while this function is still running.
  zstyle ':completion:*' use-cache on
  zstyle ':completion:*' cache-path "${ZSH_CACHE_DIR}/zcompcache"

  # Several plugins call compdef as they load, to give their aliases the
  # completion of the command behind them. compinit does not run until
  # .completions, which has to stay last because zsh-syntax-highlighting only
  # wraps widgets that already exist. Queue those calls and let .completions
  # replay them. Running compinit early instead does not work, because a second
  # compinit discards everything registered against the first.
  typeset -ga COMPDEF_DEFERRED=()
  (( ${+functions[compdef]} )) || \
    compdef() { COMPDEF_DEFERRED+=( "${(j: :)${(q)@}}" ) }

  if [[ ! "$bundle" -nt "$list" && -f "$antidote" ]]; then
    [[ -d "${bundle:h}" ]] || mkdir -p "${bundle:h}"
    source "$antidote"
    # Write then move, as plugins:update does. `>|` truncates the bundle before
    # antidote runs, so a failed rebuild would leave an empty file that the next
    # line sources and whose mtime then defeats the check above for good.
    if antidote bundle < "$list" >| "${bundle}.new"; then
      command mv -f "${bundle}.new" "$bundle"
    else
      command rm -f "${bundle}.new"
    fi
  fi

  # Job control off while the bundle loads. Nine plugins (codex, docker,
  # flutter, gh, helm, kubectl, ngrok, uv twice) regenerate completions in a
  # `&|` job on every shell, the same shape that run:daily used to fork. With
  # job control on, each job is a background process group on the terminal, and
  # one generator that touches the tty would stop it and leave its `=(...)`
  # waiter spinning at 100% CPU (see run:daily). With it off, the jobs stay in
  # the shell's foreground group and read /dev/null, so the terminal cannot stop
  # them. Only MONITOR is restored, not local_options, which would also undo the
  # options the plugins set.
  local monitor=$options[monitor]
  unsetopt monitor
  [[ -f "$bundle" ]] && source "$bundle"
  [[ "$monitor" == on ]] && setopt monitor
  return 0
}

# ----------------------------- Files & Archives ----------------------------- #

# Create a .tar.gz archive (zopfli for small inputs, otherwise pigz or gzip)
# Usage: targz <path...>
targz() {
  local tmpFile="${1%/}.tar"
  tar -cvf "${tmpFile}" --exclude=".DS_Store" "${@}" || return 1

  local size
  size=$(stat -f"%z" "${tmpFile}" 2>/dev/null)

  local cmd=""
  if (( size < 52428800 )) && cmd:exists zopfli; then
    cmd="zopfli"
  elif cmd:exists pigz; then
    cmd="pigz"
  else
    cmd="gzip"
  fi

  log info "Compressing .tar ($((size / 1000)) kB) using \`${cmd}\`…"
  # Drop the intermediate if compression fails, so a write error does not
  # strand a full-size uncompressed copy next to the source.
  "${cmd}" -v "${tmpFile}" || { command rm -f "${tmpFile}"; return 1; }
  [[ -f "${tmpFile}" ]] && command rm -f "${tmpFile}"

  local zippedSize
  zippedSize=$(stat -f"%z" "${tmpFile}.gz" 2>/dev/null)

  log success "Created ${tmpFile}.gz ($((zippedSize / 1000)) kB)"
}

# Show the size of a file, or the total size of a directory
fs() {
  if (( $# )); then
    du -sh -- "$@"
  else
    du -sh .[^.]*(N) ./*(N)
  fi
}

# Create a base64 data URL from a file
# Usage: dataurl <file>
dataurl() {
  [[ -f "${1:-}" ]] || { log error "Failed to encode (needs an existing file, run 'dataurl <file>')"; return 1; }
  local mimeType
  mimeType=$(file -b --mime-type "$1")
  if [[ $mimeType == text/* ]]; then
    mimeType="${mimeType};charset=utf-8"
  fi
  echo "data:${mimeType};base64,$(openssl base64 -in "$1" | tr -d '\n')"
}

# Serve the current directory over HTTP and open it once it answers
# Usage: server [port]
server() {
  local port="${1:-8000}"
  { retry 5 1 curl -fs "http://localhost:${port}/" -o /dev/null && open "http://localhost:${port}/"; } &
  python3 -m http.server "${port}"
}

# Compare the original and gzipped size of a file
# Usage: gz <file>
gz() {
  [[ -f "${1:-}" ]] || { log error "Failed to compare (needs an existing file, run 'gz <file>')"; return 1; }
  local origsize
  origsize=$(wc -c < "$1")
  (( origsize )) || { log error "Failed to compare (${1} is empty)"; return 1; }
  local gzipsize
  gzipsize=$(gzip -c "$1" | wc -c)
  local ratio
  ratio=$(echo "$gzipsize * 100 / $origsize" | bc -l)
  printf "orig: %d bytes\n" "$origsize"
  printf "gzip: %d bytes (%2.2f%%)\n" "$gzipsize" "$ratio"
}

# Colored tree view, skipping TREE_IGNORE paths, paged through less
trec() {
  tree -aC -I "${TREE_IGNORE}" --dirsfirst "$@" | less -FRNX
}

# Same tree view as trec, without color or paging
tre() {
  tree -a -I "${TREE_IGNORE}" --dirsfirst "$@"
}

