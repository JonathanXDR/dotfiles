#!/bin/bash
set -euo pipefail
{{ template "shell-helpers" . }}

# securityd does not auto-manage custom keychains, so every template render
# would otherwise trigger its own unlock prompt. This re-applies the lock policy
# to repair a misconfigured keychain.

KEYCHAIN_NAME={{ .keychain_name | quote }}
KEYCHAIN="${HOME}/Library/Keychains/${KEYCHAIN_NAME}.keychain-db"
KEYCHAIN_PASSWORD={{ if hasKey . "keychain_password" }}{{ .keychain_password | shellQuote }}{{ else }}""{{ end }}

# run_once_before_02 creates the keychain on a first apply
[[ -f "$KEYCHAIN" ]] || exit 0

# Unlock first, because `security set-keychain-settings` otherwise blocks on the
# GUI unlock dialog and hangs the apply. Interactive mode keeps the password out
# of the process table, and its parser needs backslashes and then double quotes
# escaped.
escaped="${KEYCHAIN_PASSWORD//\\/\\\\}"
printf 'unlock-keychain -p "%s" "%s"\n' "${escaped//\"/\\\"}" "$KEYCHAIN" | security -i
security set-keychain-settings -l "$KEYCHAIN"
