#!/bin/bash
set -euo pipefail
{{ template "shell-helpers" . }}

# This installs a root-owned copy, because a symlink to a file in $HOME would
# let any process running as this user rewrite system name resolution without
# sudo.
#
# This runs on every apply, because a macOS upgrade, Docker Desktop or a VPN
# client can replace /etc/hosts.

HOSTS_SRC="{{ .chezmoi.homeDir }}/.config/hosts"

if [[ ! -f "$HOSTS_SRC" ]]; then
  _log error "Failed to find the hosts file ($HOSTS_SRC)"
  _log info "Run 'chezmoi apply ~/.config/hosts' to link it, then apply again"
  exit 1
fi

# Back up only the first real file seen, because one written later by an
# installer must not become the backup. Neither a symlink nor content this
# script installed is worth keeping.
if [[ -f /etc/hosts && ! -L /etc/hosts && ! -e /etc/hosts.chezmoi-backup ]] \
  && ! cmp -s "$HOSTS_SRC" /etc/hosts; then
  _log info "Backing up the current /etc/hosts…"
  sudo cp /etc/hosts /etc/hosts.chezmoi-backup
  _log success "Backed up the previous /etc/hosts (/etc/hosts.chezmoi-backup)"
fi

# `cmp` follows a symlink, so test for one separately. A rename replaces a
# symlink rather than writing through it, and never leaves /etc/hosts missing on
# a failed write.
if [[ -L /etc/hosts ]] || ! cmp -s "$HOSTS_SRC" /etc/hosts; then
  _log info "Installing /etc/hosts from ${HOSTS_SRC} (requires sudo)…"
  sudo install -m 0644 -o root -g wheel "$HOSTS_SRC" /etc/hosts.chezmoi-new
  sudo mv -f /etc/hosts.chezmoi-new /etc/hosts
  _log success "Installed /etc/hosts from ${HOSTS_SRC}"
fi
