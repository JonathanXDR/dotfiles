local brew_share="${HOMEBREW_PREFIX:+${HOMEBREW_PREFIX}/share}"

# zsh-autocomplete reads this and keeps a value already set
typeset -g _comp_dumpfile="${HOME}/.cache/zsh/compdump"

# zsh-autocomplete re-adds its own entries when sourced, and copies inherited
# from a parent shell may point at a version that no longer exists.
# zsh-completions goes first, as its caveats prescribe. bun's file belongs on
# fpath, because sourcing it runs a full uncached compinit on every shell.
typeset -gU FPATH fpath
fpath=(
  ${brew_share:+${brew_share}/zsh-completions}
  ${HOME}/.bun(N/)
  ${fpath:#*/zsh-autocomplete/(Completions|z-async)}
)

# compinit -C skips a freshness check that costs about 440 ms per shell, so two
# tests here decide when to rebuild the dump: its age, and the fpath list,
# because no age check notices an edit to that list. `^ms-0` drops a dump dated
# in the future, as in run:daily. Directory mtimes do not work, because plugins
# rewrite ~/.cache/oh-my-zsh/completions on every shell. [[ ]] never globs, so
# the age test assigns to an array.
[[ -d ${_comp_dumpfile:h} ]] || mkdir -p ${_comp_dumpfile:h}
local fpath_stamp="${_comp_dumpfile}.fpath"
local -a fresh=( ${_comp_dumpfile}(N.mh-24^ms-0) )
if (( ! ${#fresh} )) || [[ ! -f $fpath_stamp || "$fpath" != "$(<$fpath_stamp)" ]]; then
  command rm -f -- "$_comp_dumpfile"
  print -r -- "$fpath" >| "$fpath_stamp"
fi

if [[ -n "$brew_share" && -f "${brew_share}/zsh-autocomplete/zsh-autocomplete.plugin.zsh" ]]; then
  # zsh-autocomplete runs compinit itself, and a foreign one makes it rebuild
  # the dump on every shell
  zstyle ':autocomplete::compinit' arguments -C

  # The async redraw loop wipes Kiro's figterm inline suggestions
  zstyle ':autocomplete:async' enabled no

  source "${brew_share}/zsh-autocomplete/zsh-autocomplete.plugin.zsh"
else
  autoload -Uz compinit
  compinit -C -d "$_comp_dumpfile"
fi

# With zsh-autocomplete these land in its own queue, flushed after its compinit
if (( ${#COMPDEF_DEFERRED} )); then
  local deferred
  for deferred in "${COMPDEF_DEFERRED[@]}"; do
    eval "compdef ${deferred}"
  done
fi
unset COMPDEF_DEFERRED

_claude_accounts() {
  (( CURRENT == 2 )) && compadd -- "${HOME}"/.claude-accounts/*(N/:t)
}
compdef _claude_accounts claude:as claude:chrome claude:remove

# Generating this spawns Node, so it is kept for a day. $SHELL is forced because
# yargs emits the bash flavor otherwise, and the header check rejects a
# truncated reply.
if cmd:exists ng; then
  local ng_completion="${HOME}/.cache/zsh/ng-completion.zsh"
  local -a ng_fresh=( ${ng_completion}(N.mh-24^ms-0) )
  if (( ! ${#ng_fresh} )); then
    if SHELL=/bin/zsh ng completion script >| "${ng_completion}.new" 2>/dev/null &&
       [[ "$(head -n 1 "${ng_completion}.new")" == "#compdef ng" ]]; then
      command mv -f "${ng_completion}.new" "$ng_completion"
    else
      # Stamp a failed attempt too, or a broken ng respawns Node before every
      # prompt. An empty file fails the -s test below.
      command rm -f "${ng_completion}.new"
      command touch "$ng_completion"
    fi
  fi
  [[ -s "$ng_completion" ]] && source "$ng_completion"
fi

if [[ -n "$brew_share" ]]; then
  [[ -f "${brew_share}/zsh-autosuggestions/zsh-autosuggestions.zsh" ]] \
    && source "${brew_share}/zsh-autosuggestions/zsh-autosuggestions.zsh"
fi

# zsh-autocomplete leaves no key on `menu-select`. The wrapper clears the
# autosuggestion ghost text, which otherwise gets committed into the buffer. It
# binds into `main`, because zsh-autocomplete rebuilds `emacs` from a precmd
# hook.
if (( $+widgets[menu-select] )); then
  _zsh_autocomplete_menu() {
    unset POSTDISPLAY
    zle menu-select
  }

  zle -N _zsh_autocomplete_menu
  bindkey '\e[Z' _zsh_autocomplete_menu
fi

# These wrap existing ZLE widgets, so they come after every widget above
if [[ -n "$brew_share" ]]; then
  [[ -f "${brew_share}/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh" ]] \
    && source "${brew_share}/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"

  [[ -f "${brew_share}/zsh-history-substring-search/zsh-history-substring-search.zsh" ]] \
    && source "${brew_share}/zsh-history-substring-search/zsh-history-substring-search.zsh"
fi

# `local` outside a function is `typeset`, and this file is sourced
unset brew_share fpath_stamp fresh deferred ng_completion ng_fresh
