#!/bin/bash
# Registered for every tool, because Monitor, PowerShell, Tmux and REPL run
# shell commands too, and an MCP server can carry a path under any key.
#
# permissions.deny gets the same list and reaches @ mentions, but a managed
# policy setting allowManagedPermissionRulesOnly drops it, so this hook assumes
# it is the only enforcement.
#
# Matching is on path text, because far too many commands, aliases and builtins
# can read a file.
#
# Accepted misses:
#   - a reader rooted at an ancestor of a blocked path, which cannot be caught
#     without failing every search from the home directory
#   - writing a script that reads the path, then running the script
#   - `git cat-file -p <sha>`, which names a blob hash rather than a path
#   - mdfind, which answers questions about content without opening the file
#   - paths assembled at runtime from variables or escape sequences
#   - a project setting disableAllHooks

payload=$(cat)

# Every string in tool_input is a candidate path, so a tool's key does not
# matter. Free-text fields go first, or prose mentioning a blocked path could
# not be written. Grep's pattern is a content regex, while Glob's is a path
# pattern and stays. A jq failure over-blocks on the raw payload.
if command -v jq >/dev/null 2>&1; then
  subject=$(printf '%s' "$payload" | jq -r '
    . as $t
    | [ (.tool_input // {})
        | walk(if type == "object"
               then del(.content, .description, .prompt, .query,
                        .old_string, .new_string, .new_source)
               else . end)
        | if $t.tool_name == "Grep" then del(.pattern) else . end
        | .. | strings ]
    | join("\n")') || subject=$payload
else
  subject=$payload
fi
[ -n "$subject" ] || exit 0

# Single-quoted with apostrophes escaped, so an entry is data and cannot break
# the hook
blocked=(
{{- range .claude_blocked_paths }}
  {{ printf "'%s'" (replace "'" "'\\''" .) }}
{{- end }}
)
[ ${#blocked[@]} -gt 0 ] || exit 0

# On stdin, because the subject is routinely multi-line and macOS awk rejects a
# newline in a -v value, which would fail the guard open. norm() lowercases
# because APFS is case-insensitive by default, and strips quotes so a path split
# across them still reads as one path.
hit=$({ printf '%s\n' "${blocked[@]}"; printf '\034\n'; printf '%s\n' "$subject"; } |
  awk -v home="$HOME" '
  function norm(s,   prev) {
    gsub(/["\047\\]/, "", s)
    s = tolower(s)
    gsub(/\$\{home\}/, H, s)
    gsub(/\$home/, H, s)
    gsub(/~\//, H "/", s)
    gsub(/\/\/+/, "/", s)
    while (s ~ /\/\.\//) gsub(/\/\.\//, "/", s)
    # A segment must be free of whitespace, or a later /../ would swallow the
    # blocked path together with everything before it. ".." is excluded, so
    # ../../ does not eat a level.
    do {
      prev = s
      sub(/\/(\.[^.\/[:space:]][^\/[:space:]]*|[^.\/[:space:]][^\/[:space:]]*)\/\.\.\//, "/", s)
    } while (s != prev)
    return s
  }
  function esc(s,   out, i, ch) {
    out = ""
    for (i = 1; i <= length(s); i++) {
      ch = substr(s, i, 1)
      out = out (ch ~ /[][(){}.*+?^$|\\\/]/ ? "\\" ch : ch)
    }
    return out
  }
  BEGIN { H = tolower(home); sub(/\/+$/, "", H); reading = 1 }
  reading { if ($0 == "\034") reading = 0; else entry[++n] = $0; next }
  # Here, because a bash substitution is super-quadratic in 3.2, and a long
  # command would time out and fail open
  {
    if (pend != "") { $0 = pend $0; pend = "" }
    if ($0 ~ /\\$/) { pend = substr($0, 1, length($0) - 1); next }
    view = view "\n" $0
  }
  END {
    if (pend != "") view = view "\n" pend
    view = norm(view)
    for (i = 1; i <= n; i++) {
      needle = norm(entry[i])
      if (needle == "") continue
      # A path entry is a plain substring, which also catches an unexpanded
      # glob. A bare name needs component boundaries, and a dot closes a
      # component without opening one.
      if (index(needle, "/") > 0) {
        if (index(view, needle) > 0) { print entry[i]; exit }
      } else if (match(view, "(^|[^[:alnum:]._-])" esc(needle) "($|[^[:alnum:]_-])")) {
        print entry[i]; exit
      }
    }
  }')

[ -n "$hit" ] || exit 0

cat >&2 <<REASON
Blocked path: this call references $hit, which the dotfiles list in
claude_blocked_paths as off limits. Reading or modifying it is not permitted and
there is no override, so do not look for another tool or command that reaches
the same file. Every tool is guarded, not just Bash.
Work around the file, or ask the user to remove the entry from
.chezmoidata.toml and run chezmoi apply if it genuinely needs to be reachable.
REASON
exit 2
