    "code-review@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "coderabbit@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "data-engineering@claude-plugins-official": true,
    "data@claude-plugins-official": true,
    "deploy-on-aws@claude-plugins-official": true,
    "discord@claude-plugins-official": true,
    "feature-dev@claude-plugins-official": true,
    "figma@claude-plugins-official": true,
    "firecrawl@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": false,
    "github@claude-plugins-official": true,
    "gitkraken-hooks@gitkraken": true,
    "gitlab@claude-plugins-official": false,
    "hookify@claude-plugins-official": true,
    "huggingface-skills@claude-plugins-official": true,
    "kotlin-lsp@claude-plugins-official": true,
    "learning-output-style@claude-plugins-official": true,
    "linear@claude-plugins-official": true,
    "mattpocock-skills@claude-plugins-official": false,
    "mcp-server-dev@claude-plugins-official": true,
    "microsoft-docs@claude-plugins-official": true,
    "notion@claude-plugins-official": true,
    "playground@claude-plugins-official": true,
    "playwright@claude-plugins-official": true,
    "plugin-dev@claude-plugins-official": true,
    "postman@claude-plugins-official": true,
    "pr-review-toolkit@claude-plugins-official": true,
    "prisma@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "railway@claude-plugins-official": true,
    "ralph-loop@claude-plugins-official": true,
    "rc@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": false,
    "slack@claude-plugins-official": true,
    "sourcegraph@claude-plugins-official": true,
    "stripe@claude-plugins-official": true,
    "supabase@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "swift-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "vercel@claude-plugins-official": true,
    "watch@claude-video": true
  },
  "extraKnownMarketplaces": {
    "claude-video": {
      "source": {
        "source": "github",
        "repo": "bradautomates/claude-video"
      }
    },
    "gitkraken": {
      "source": {
        "source": "directory",
        "path": "{{ .chezmoi.homeDir }}/.claude/plugins/marketplaces/gitkraken"
      }
    }
  },
  "spellcheck": {
    "enabled": true,
    "language": "en_US"
  },
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "xhigh"
    }
  },
  "tui": "fullscreen",
  "voice": {
    "enabled": true,
    "mode": "tap"
  },
  "skipDangerousModePermissionPrompt": true,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true
}
