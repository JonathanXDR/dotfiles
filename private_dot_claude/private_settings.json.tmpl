{
  "cleanupPeriodDays": 3650,
  "env": {
    "CLAUDE_CODE_RETRY_WATCHDOG": "1"
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "deny": [
{{- $rules := list }}
{{- range .claude_blocked_paths }}
{{-   $p := . }}
{{-   if not (contains "/" $p) }}{{ $p = printf "//**/%s" $p }}
{{-   else if and (hasPrefix "/" $p) (not (hasPrefix "//" $p)) }}{{ $p = printf "/%s" $p }}
{{-   end }}
{{-   range $form := (list $p (printf "%s/**" $p)) }}
{{-     $rules = append (append $rules (printf "Read(%s)" $form)) (printf "Edit(%s)" $form) }}
{{-   end }}
{{- end }}
{{- range $i, $r := $rules }}{{ if $i }},{{ end }}
      {{ $r | quote }}
{{- end }}
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "'{{ .chezmoi.homeDir }}/.claude/hooks/block-git-push.sh'",
            "if": "Bash(git *)"
          },
          {
            "type": "command",
            "command": "'{{ .chezmoi.homeDir }}/.claude/hooks/block-git-destructive.sh'",
            "if": "Bash(git *)"
          },
          {
            "type": "command",
            "command": "'{{ .chezmoi.homeDir }}/.claude/hooks/check-commit-message.sh'",
            "if": "Bash(git *)"
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "'{{ .chezmoi.homeDir }}/.claude/hooks/block-path-access.sh'"
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "'{{ .chezmoi.homeDir }}/.claude/hooks/sonar-secrets/build-scripts/pretool-secrets.sh'",
            "timeout": 60
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "'{{ .chezmoi.homeDir }}/.claude/hooks/lock-memory-writes.sh'",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "'{{ .chezmoi.homeDir }}/.claude/hooks/scan-written-secrets.sh'",
            "timeout": 60
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "'{{ .chezmoi.homeDir }}/.claude/hooks/lock-memory-writes.sh'",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "'{{ .chezmoi.homeDir }}/.claude/hooks/lock-memory-writes.sh'",
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "'{{ .chezmoi.homeDir }}/.claude/hooks/sonar-secrets/build-scripts/prompt-secrets.sh'",
            "timeout": 60
          },
          {
            "type": "command",
            "command": "'{{ .chezmoi.homeDir }}/.claude/hooks/guard-live-sessions.sh'",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'{{ .chezmoi.homeDir }}/.claude/hooks/warn-denied-tools.sh'",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "'{{ .chezmoi.homeDir }}/.claude/hooks/guard-live-sessions.sh'",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'{{ .chezmoi.homeDir }}/.claude/hooks/guard-live-sessions.sh'",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
