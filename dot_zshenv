# Sourced by every zsh, so anything interactive belongs in .zshrc

# Nested shells re-source this file
typeset -gU PATH path

# Set before /etc/zprofile, whose C.UTF-8 fallback would otherwise win in login shells
export LANG="${LANG:-en_US.UTF-8}"

# This serves editors, LaunchAgents and `zsh -c` scripts, which never read
# .zshrc. /etc/zprofile undoes it in login shells, so .zprofile repeats it.
[[ -d "$HOME/.local/share/mise/shims" ]] && path=("$HOME/.local/share/mise/shims" $path)
