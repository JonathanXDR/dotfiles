# Sourced by every zsh, so anything interactive belongs in .zshrc

# Nested shells re-source this file
typeset -gU PATH path

# Set before /etc/zprofile, whose C.UTF-8 fallback would otherwise win in login shells
export LANG="${LANG:-en_US.UTF-8}"

# This serves editors, LaunchAgents and `zsh -c` scripts, which never read
# .zshrc. /etc/zprofile undoes it in login shells, so .zprofile repeats it. A
# non-login child of an activated shell keeps the shims behind the real tool
# directories. It is an if rather than &&, because a failed test would become
# the exit status of `zsh -c` scripts.
if [[ -d "$HOME/.local/share/mise/shims" ]] && (( ! ${path[(Ie)$HOME/.local/share/mise/shims]} )); then
  path=("$HOME/.local/share/mise/shims" $path)
fi
