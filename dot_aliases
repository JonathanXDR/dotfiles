# ------------------------------------ Git ----------------------------------- #
# The git plugin defines about 200 aliases and loads first, so the names below
# are the ones this file deliberately keeps. Five differ from the plugin's in
# meaning. gst is a contributor shortlog rather than status, gpu pushes to the
# default remote rather than upstream, gau adds an upstream remote rather than
# staging tracked files, gca takes the message inline, and gwip keeps GPG
# signing, which the plugin's version disables. glo and gclean differ only in
# flags. g, gaa, gb, gco, gcb, gd and gds are restated verbatim so this file
# stays the single place to read them. Four more names (gba, gbd, gcl, glg) are
# left out so the plugin's versions win.

alias:safe g="git"
alias:safe gs="git status"
alias:safe gca="git commit -a -m"
alias:safe gau="git remote add upstream"
alias:safe gaa="git add --all"
alias:safe gpl="git pull"
alias:safe gpu="git push"
alias:safe gps="git push && say You are awesome!"
alias:safe gst="git shortlog -sn"
alias:safe gch="git checkout"
alias:safe gsl="git stash list"
alias:safe gsc="git stash clear"
alias:safe gd='git diff'
alias:safe gds='git diff --staged'
alias:safe gco='git checkout'
alias:safe gcb='git checkout -b'
alias:safe gb='git branch'
alias:safe gun='git reset HEAD~1'
alias:safe glo='git log --oneline --graph --decorate'
alias:safe gwip='git add -A && git commit -m "wip"'
alias:safe gclean='git clean -fd'

