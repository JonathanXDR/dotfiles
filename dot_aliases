# alias:safe is the default. Plain `alias` is for deliberate shadows and syntax
# the helpers cannot wrap (`alias -s`, `alias -- -=`).

# --------------------------- Plugin Corrections ----------------------------- #

# zsh refuses to declare the rm wrapper below over an alias of that name, and
# the parse error fails the whole file
unalias rm cp mv 2>/dev/null

# This runs before this file's own suffix aliases, so it prunes only the
# plugin's
alias:prune-suffix

# Quoted, because global aliases otherwise expand before unalias sees them
unalias "M" "P" 2>/dev/null

# Give these back to their binaries: coreutils (gcp grm gpr god), Coursier (cs),
# and the Angular CLI and @antfu/ni (ng ni na). `cu` and `asr` stay shadowed on
# purpose.
unalias gcp grm gpr god cs ng ni na 2>/dev/null

# The emacs plugin points `emacs` at its emacsclient wrapper
unalias emacs 2>/dev/null

