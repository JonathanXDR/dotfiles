# Helpers used below (defined in dot_functions):
#   alias:safe      sets the alias unless a real command owns that name, and
#                   warns whenever it skips one (default)
#   alias:fallback  the same, minus the warning (used for polyfills)
#   plain `alias`   deliberate shadows (cat→bat, top→btop, etc.) and syntax
#                   the helpers cannot wrap (`alias -s`, `alias -- -=`)

# --------------------------- Plugin Corrections ----------------------------- #
# The Oh My Zsh bundle (~/.plugins) loads immediately before this file. Anything
# further down overrides it by defining the same name again. This section covers
# the cases that need a removal instead, which is why it runs first.
#
# `alias:shadows` prints every alias currently sitting on a real binary. Run it
# after adding a plugin to see whether this list needs another entry.

# common-aliases makes rm, cp and mv interactive. rm is the urgent one. Its
# alias has to go before the rm wrapper below can be defined at all,
# because zsh refuses to declare a function whose name is an existing alias and
# fails the whole file with a parse error at that line.
unalias rm cp mv 2>/dev/null

# Drop common-aliases' suffix aliases whose viewer is not installed here and
# keep the ones that work, so `.tar` still lists an archive and `.c` still opens
# an editor. This file sets its own suffix aliases at the bottom, so the only
# suffix aliases defined when this runs are the plugin's.
alias:prune-suffix

# Global aliases expand anywhere on the line, so the two whose tool is missing
# would fire on any bare M or P. The names have to be quoted, because unquoted
# they expand as global aliases before unalias ever sees them, leaving it with
# no arguments. zsh has no `unalias -g` either.
unalias "M" "P" 2>/dev/null

# Give these names back to their binaries. Every one is a tool installed on
# purpose, so the plugin alias loses:
#   gcp grm gpr god  coreutils cp, rm, pr and od
#   cs               the Coursier launcher, which .zshrc deliberately appends to
#                    PATH so it never shadows another binary
#   ng ni na         the Angular CLI and @antfu/ni, both pinned in
#                    mise/config.toml. The nestjs plugin claims all three, and
#                    ng also has a hand-written completion in .completions
# Two shadows stay on purpose: `cu` (composer update over the legacy serial-line
# tool) and `asr` (aws over Apple Software Restore).
unalias gcp grm gpr god cs ng ni na 2>/dev/null

# The emacs plugin points `emacs` at its own emacsclient wrapper. Keep the
# Homebrew binary. Every other alias the plugin sets stays.
unalias emacs 2>/dev/null

# -------------------------- Filesystem & Navigation ------------------------- #

# Number the directory stack for `cd -<n>` (deliberate shadow of the builtin)
alias dirs='dirs -v'

# Climb directories (~ for home, `-` for previous)
alias:safe ..="cd .."
alias:safe ...="cd ../.."
alias:safe ....="cd ../../.."
alias:safe .....="cd ../../../.."
alias:safe ~="cd ~"
alias -- -="cd -"

# Prefer lsd if available, otherwise colorize ls (deliberate shadow of /bin/ls)
if cmd:exists lsd; then
  alias ls='lsd'
  # common-aliases builds lS, lart and lrt on BSD ls flags lsd does not
  # implement (-s for block sizes, -c for ctime ordering), so routed through
  # the alias above all three answer with a usage error and exit 2 instead of
  # listing anything. Drop them rather than leave three dead names in the
  # table. Without lsd the plugin's own ls serves them, so there they stay.
  unalias lS lart lrt 2>/dev/null
else
  alias ls='command ls -G'
  export LSCOLORS='BxBxhxDxfxhxhxhxhxcxcx'
fi

# l (long format) and la (long format, all but . and ..) come from the
# common-aliases plugin, which also passes -h for readable sizes. Both still
# chain through the ls alias above, so lsd renders them.

# List only directories. Named lsdir to avoid colliding with lsd, the Homebrew
# binary that `ls` aliases to when it is installed.
alias:safe lsdir="command ls -lF | grep --color=never '^d'"

# Print each PATH entry on a separate line
alias:safe path='echo -e ${PATH//:/\\n}'

# ------------------------------- System Tools ------------------------------- #

# Deliberate shadows: prefer modern replacements when installed
cmd:exists python3 && alias python=python3
cmd:exists btop    && alias top='btop'
cmd:exists bat     && alias cat='bat --paging=never'

# Safer rm, moving files to the macOS Trash so Finder can put them back. Uses
# the trash command that ships with macOS 15 and later, by full path so no
# other `trash` on PATH can stand in for it.
if [[ -x /usr/bin/trash ]]; then
  rm() {
    # zsh defaults, whatever the caller set (agents often run set -euo pipefail)
    emulate -L zsh
    local arg real ret=0 opts=()
    # Parse like BSD rm. A lone `-` is a file name, which zparseopts -D would
    # drop. The letters are rm's minus -W (undelete), and f+ i+ keep the order
    # of -f and -i, since the last one wins. An unknown option fails zparseopts
    # with the arguments untouched, and the real rm rejects it before removing
    # anything.
    set -- "${@:/-/./-}"
    zparseopts -D -F -a opts -- d f+ i+ I P R r v x 2>/dev/null ||
      { command rm "$@"; return }
    # The real rm keeps the whole call when there is no operand, so the caller
    # gets its usage error, and when -i wins, so it asks before every removal.
    # -I only guards against mistakes, which the Trash already undoes.
    [[ $# -eq 0 || ${opts[(R)-[fi]]} == -i ]] &&
      { command rm "${opts[@]}" -- "$@"; return }
    # One operand at a time, in order, like rm. trash records Finder's Put Back
    # location only for the first item of a run, and an operand that already
    # went with an earlier one then reaches the real rm as missing.
    for arg; do
      # trash collapses .. as text, so hand it the parent resolved physically
      real=${arg:h:P}/${arg:t}
      # The real rm takes what trashing gets wrong: missing paths (reported, or
      # silent under -f), `/`, `.` and `..` (refused), TRASH_SKIP names (set in
      # .exports) for bulky throwaway directories, and anything already in a
      # Trash, where trash silently does nothing. :t ignores a trailing slash.
      if [[ ! -e $arg && ! -L $arg || ${arg:t} == (|.|..|${~TRASH_SKIP}) ||
            $real == ($HOME/.Trash|/Volumes/*/.Trashes)(|/*) ]]; then
        command rm "${opts[@]}" -- "$arg"
      else
        /usr/bin/trash ${opts[(r)-v]} "$real"
      fi || ret=$?
    done
    return $ret
  }
fi

# Deliberate shadows: ssh adds each key to the agent on first use, and bash
# carries a PERMIT_BASH marker that nothing in this repo reads
alias ssh='ssh -o AddKeysToAgent=yes'
alias bash='PERMIT_BASH=true bash'

# Restart the shell in place, as a login shell
alias:safe reload="exec ${SHELL} -l"
alias:safe rld="reload"

# Clear the terminal screen
alias:safe clr="clear"

