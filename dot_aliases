# --------------------------------- Utilities -------------------------------- #

# Colored `grep` output comes from the common-aliases plugin, which self-shadows
# /usr/bin/grep with `grep --color`.

# Trailing space makes zsh expand the next word as an alias too, so aliases can
# be sudo'ed (deliberate self-shadow)
alias sudo='sudo '

# Update macOS, Homebrew, mise-managed tools, and Ruby gems (the mise and gem
# steps are guarded by cmd:exists). mise runs with -C "$HOME" so it upgrades the
# global toolchain, not whichever project the shell happens to sit in. The gem
# steps run without sudo on purpose. `gem` is a mise shim into a Ruby install
# under $HOME, so the user already owns everything it writes, and a shim run
# with another account's environment cannot read the mise config that tells it
# which Ruby to use.
alias:safe update='sudo softwareupdate -i -a; brew update && brew upgrade && brew cleanup; cmd:exists mise && mise -C "$HOME" upgrade; cmd:exists gem && gem update --system && gem update && gem cleanup'

# macOS ships no `hd`, and only recent releases ship `md5sum` and `sha1sum` in
# /sbin, so those two fallbacks are no-ops here. alias:fallback supplies each
# quietly and steps aside where the real binary already exists.
alias:fallback hd="hexdump -C"
alias:fallback md5sum="md5"
alias:fallback sha1sum="shasum"

# JavaScriptCore REPL
if [[ -e "/System/Library/Frameworks/JavaScriptCore.framework/Versions/A/Resources/jsc" ]]; then
  alias:safe jsc="/System/Library/Frameworks/JavaScriptCore.framework/Versions/A/Resources/jsc"
fi

# Disk usage of entries in the current directory (sorted) and free space. dud
# delegates to fs from .functions, which counts dotfiles (a bare * hides .git,
# usually the largest entry) and survives an empty directory, where an
# unmatched * is fatal under NOMATCH.
alias:safe dud='fs | sort -h'
alias:safe duf='df -h'

