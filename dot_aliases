# By full path, so no other `trash` on PATH can stand in for it
if [[ -x /usr/bin/trash ]]; then
  rm() {
    # zsh defaults, whatever the caller set (agents often run set -euo pipefail)
    emulate -L zsh
    local arg real ret=0 opts=()
    # A lone `-` is a file name, which zparseopts -D would drop. f+ i+ keep the
    # order of -f and -i, since the last wins. The real rm rejects an unknown
    # option.
    set -- "${@:/-/./-}"
    zparseopts -D -F -a opts -- d f+ i+ I P R r v x 2>/dev/null ||
      { command rm "$@"; return }
    # The real rm reports a missing operand and asks before each removal under
    # -i. -I is ignored, because the Trash already undoes mistakes.
    [[ $# -eq 0 || ${opts[(R)-[fi]]} == -i ]] &&
      { command rm "${opts[@]}" -- "$@"; return }
    # One at a time, because trash records Put Back only for the first item of a
    # run
    for arg; do
      # trash collapses .. as text, so hand it the parent resolved physically
      real=${arg:h:P}/${arg:t}
      # The real rm takes what trash gets wrong: missing paths, `/`, `.` and
      # `..`, the bulky TRASH_SKIP names, and anything already in a Trash, where
      # trash does nothing
      if [[ ! -e $arg && ! -L $arg || ${arg:t} == (|.|..|${~TRASH_SKIP}) ||
            $real == ($HOME/.Trash|/Volumes/*/.Trashes)(|/*) ]]; then
        command rm "${opts[@]}" -- "$arg"
      else
        /usr/bin/trash ${opts[(r)-v]} "$real"
      fi || ret=$?
    done
    return $ret
  }
fi

