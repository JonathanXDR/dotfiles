# Without -f an HTTP error page prints as if it were the IP
alias:safe myip='curl -fsS --max-time 10 ifconfig.me'

alias:safe ifactive="ifconfig | awk '/^[^[:space:]]/{iface=substr(\$1, 1, length(\$1)-1)} /status: active/{print iface}'"

alias:safe ports='lsof -i -P -n | grep LISTEN'

