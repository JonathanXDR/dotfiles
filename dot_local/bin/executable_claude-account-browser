#!/bin/sh
# Claude Code sends every clicked link through BROWSER, so app links such as
# vscode: go to `open`. The directory name starts with "Profile " because
# Default and Profile * are the only names Claude Code scans for the extension.

: "${CLAUDE_CONFIG_DIR:?run this through claude:as or claude:chrome}"

case "${1:-https:}" in
  http:* | https:*) ;;
  *) exec open "$@" ;;
esac

exec open -na "Google Chrome" --args --profile-directory="Profile claude-${CLAUDE_CONFIG_DIR##*/}" "$@"
