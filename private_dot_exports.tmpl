export EDITOR={{ .editor | quote }}
export KUBE_EDITOR={{ .editor | quote }}

# Infisical Universal Auth machine identity for Application-Website-Frontend
export INFISICAL_CLIENT_ID={{ includeTemplate "keychain" (list "Infisical Client ID" "jonathan" .keychain_name .keychain_lookup_field) | quote }}
export INFISICAL_CLIENT_SECRET={{ includeTemplate "keychain" (list "Infisical Client Secret" "jonathan" .keychain_name .keychain_lookup_field) | quote }}

export NODE_TLS_REJECT_UNAUTHORIZED="${NODE_TLS_REJECT_UNAUTHORIZED:-1}"

export NODE_REPL_HISTORY="${NODE_REPL_HISTORY:-$HOME/.node_history}"
export NODE_REPL_HISTORY_SIZE="${NODE_REPL_HISTORY_SIZE:-32768}"
export NODE_REPL_MODE="${NODE_REPL_MODE:-sloppy}"

# 3 is 24-bit color
export FORCE_COLOR=3

export PYTHONIOENCODING="${PYTHONIOENCODING:-UTF-8}"

HISTSIZE={{ .history_size }}
SAVEHIST=$HISTSIZE
# Unconditional, because /etc/zshrc has already set it to $ZDOTDIR/.zsh_history
HISTFILE="$HOME/.zsh_history"

setopt HIST_IGNORE_DUPS
setopt HIST_IGNORE_SPACE
setopt HIST_REDUCE_BLANKS
setopt SHARE_HISTORY

# HISTORY_IGNORE alone only filters the file write, so the hook keeps matches
# out of `history` too
HISTORY_IGNORE='({{ .history_ignore | join "*|" }}*)'
zshaddhistory() {
  emulate -L zsh -o extended_glob
  [[ "${1%$'\n'}" != ${~HISTORY_IGNORE} ]]
}

export MANPAGER="${MANPAGER:-less -X}"

# $TTY is zsh's own copy of what `tty` reports, so this needs no fork
export GPG_TTY="$TTY"

export DEFAULT_HOSTNAME={{ .default_hostname | quote }}

export SECRETS_TOKENS_FILE={{ joinPath .icloud_secrets ".keychain/tokens" | quote }}

export SECRETS_KEYCHAIN_NAME={{ .keychain_name | quote }}
export SECRETS_KEYCHAIN_LOOKUP_FIELD={{ .keychain_lookup_field | quote }}
# Not exported, because only functions in this shell read it
typeset +x SECRETS_KEYCHAIN_PASSWORD={{ if hasKey . "keychain_password" }}{{ .keychain_password | shellQuote }}{{ else }}""{{ end }}

export TREE_IGNORE={{ .tree_ignore | quote }}

export TRASH_SKIP={{ .trash_skip | join "|" | quote }}

export DOCK_APPS={{ .dock_apps | join "," | quote }}

export PATH_ADD="${PATH_ADD:-}"

export AUTOSTART_SSH_AGENT="${AUTOSTART_SSH_AGENT:-{{ .autostart_ssh_agent }}}"
